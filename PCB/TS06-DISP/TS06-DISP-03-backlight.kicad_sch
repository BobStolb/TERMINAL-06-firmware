(text "TS06-DISP  ·  Backlight"
(exclude_from_sim no)
(at 20.32 12.7 0)
(effects
(font
(size 3 3)
(bold yes)
)
(justify left top)
)
(uuid "e7f7e08c-596d-511c-add0-4ecbc5864808")
)
(text "Eight amber LEDs behind the tubes are each sourced from their own MCP23017 port-B pin through an isolated 8 x 220R network; the 'm' LED of AM/PM runs\nfrom D12 through 220R. All nine cathodes share BL_K behind one MPSA42, so D11's PWM sets the brightness of them all."
(exclude_from_sim no)
(at 20.32 19.05 0)
(effects
(font
(size 1.524 1.524)
)
(justify left top)
)
(uuid "f1215ed1-7bea-5581-8a8c-035ba0043479")
)
(text "Notes from tools/ts06pair.py"
(exclude_from_sim no)
(at 20.32 67.31 0)
(effects
(font
(size 1.524 1.524)
(bold yes)
)
(justify left top)
)
(uuid "084b15b1-342c-5923-ab66-39bf10e8a71e")
)
(text "HL1..HL8: Backlight, addressable: anode from its own MCP23017 port-B pin, cathode on the common BL_K.\nHL9: The m of AM/PM behind its stencil: anode from D12, cathode on BL_K so it dims with the backlight."
(exclude_from_sim no)
(at 20.32 69.85 0)
(effects
(font
(size 1.27 1.27)
)
(justify left top)
)
(uuid "218d62b7-60b0-5d2d-b88b-f88c5f69fcb9")
)
