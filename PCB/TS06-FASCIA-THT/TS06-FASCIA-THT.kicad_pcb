(footprint "TS06_Rotary_SR25_THT"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(uuid "c4238575-889a-4240-9d20-978ea02fe65b")
	(at 30.0000 26.0000)
	(descr "SR25-style rotary, panel mount, with THROUGH-HOLE wire landing pads on 13 mm pitch so a 10.16 mm axial resistor sits between each adjacent pair. Bushing hole 8.80 mm from the calipered 8.62 mm bushing; F.Fab circle is the 25.00 mm body keepout behind the panel. Pad order descends +5V, TAP5..TAP2, GND, then COM.")
