(footprint "TS06_R_Axial_EdgeToEdge"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(uuid "66595e59-190a-4984-8832-414af377a1ad")
	(at 3.2500 13.1010)
	(descr "Axial resistor, mounted crosswise on a 6.5 mm board. Real body length is ~6 mm; pad pitch is 5.2 mm, slightly narrower than the body, with leads bent in a touch from each end so the copper pads stay legally on the board (a 6.0 mm pitch put the pad copper itself past the board edge, not just the courtyard - checked and fixed, not just eyeballed). The body's silkscreen outline is drawn at its real ~6 mm length and slightly overhangs the pads at each end - normal for this mounting style. This is the short-in-Y orientation, opposite of TS06_R_Axial_P10.16mm_Vertical, used where board LENGTH matters more than width.")
	(tags "resistor axial THT edge-to-edge TERMINAL-06")
	(attr through_hole)
	(property "Reference" "R1"
		(at 0 -2.2 0)
