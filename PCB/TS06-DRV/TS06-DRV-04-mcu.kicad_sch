(text "TS06-DRV  ·  MCU and I2C"
(exclude_from_sim no)
(at 20.32 12.7 0)
(effects
(font
(size 3 3)
(bold yes)
)
(justify left top)
)
(uuid "b6a6177b-67e9-51c8-b950-a861fb4ef429")
)
(text "An Arduino Nano on two 1x15 female strips runs the clock, with the firmware's BOARD_TYPE 4 pin map. A4 and A5 carry the I2C bus to the MCP23017 and\nthe RTC module, pulled up to 5 V through 4k7."
(exclude_from_sim no)
(at 20.32 19.05 0)
(effects
(font
(size 1.524 1.524)
)
(justify left top)
)
(uuid "c666071c-7097-531f-833d-3a73a57bc082")
)
(text "I2C bus: pulled up here; on it U3, the MCP23017 at 0x20 (AM/PM),\nand U13, the DS3231 module (RTC)."
(exclude_from_sim no)
(at 30.48 96.52 0)
(effects
(font
(size 1.27 1.27)
)
(justify left top)
)
(uuid "d6c6ca34-b433-5795-aaf1-7b77cc058b0b")
)
(text "Notes from tools/ts06pair.py"
(exclude_from_sim no)
(at 20.32 118.11 0)
(effects
(font
(size 1.524 1.524)
(bold yes)
)
(justify left top)
)
(uuid "aaad7c7f-dbf3-5f6d-b869-c830a34bd18b")
)
(text "R54: I2C pull-ups.\nU1: On two 1x15 female strips. Pin map is the firmware's (see the module docstring)."
(exclude_from_sim no)
(at 20.32 120.65 0)
(effects
(font
(size 1.27 1.27)
)
(justify left top)
)
(uuid "612d3b22-8211-52cf-863c-0ad738b08b14")
)
