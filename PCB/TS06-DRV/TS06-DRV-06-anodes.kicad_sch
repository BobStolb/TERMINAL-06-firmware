(text "Notes from tools/ts06pair.py"
(exclude_from_sim no)
(at 20.32 151.13 0)
(effects
(font
(size 1.524 1.524)
(bold yes)
)
(justify left top)
)
(uuid "a07cd155-a80a-5035-94d3-469e88e71f5b")
)
(text "R21..R26: Opto LED, ~8 mA.\nR27..R32: Anode series resistor, one per tube; TBC values wait for bench gate 2.\nR33..R43: Bleed pair, DNP unless the bench asks; ~92 V each, standing to keep the channel compact.\nU5..U10: Anode switch for H10, H1, M10, M1, S10, S1 in turn: 1 LED anode, 2 LED cathode, 3 emitter, 4 collector."
(exclude_from_sim no)
(at 20.32 153.67 0)
(effects
(font
(size 1.27 1.27)
)
(justify left top)
)
(uuid "e9583a0d-5de3-515e-94cb-37ea1c6a6061")
)
