(text "TS06-DRV  ·  Anode drivers"
(exclude_from_sim no)
(at 20.32 12.7 0)
(effects
(font
(size 3 3)
(bold yes)
)
(justify left top)
)
(uuid "3f363c30-9bd9-5012-8e60-a8735320f5ad")
)
(text "Six identical channels, one per digit tube. A Nano pin lights a TLP627's LED through 470 R, and the opto's 300 V Darlington connects HV185 to the\ntube's anode through its series resistor. The 510k bleed pairs are fitted only if the bench asks for them."
(exclude_from_sim no)
(at 20.32 19.05 0)
(effects
(font
(size 1.524 1.524)
)
(justify left top)
)
(uuid "4b82d1cb-0f8f-5306-8f4d-2d55eedf5d0c")
)
