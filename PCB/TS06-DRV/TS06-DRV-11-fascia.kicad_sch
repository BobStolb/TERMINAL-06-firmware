(at 20.32 12.7 0)
(effects
(font
(size 3 3)
(bold yes)
)
(justify left top)
)
(uuid "fd43b13f-4c88-57a8-b390-76d16e671290")
)
(text "The panel cable leaves on a top-entry 6-way JST PH: +5V, GND, A6, A7, D7, D8, the pin order both fascia builds\nshare. The 100 nF ladder filters on A6 and A7 sit at this end of the cable."
(exclude_from_sim no)
(at 20.32 19.05 0)
(effects
(font
(size 1.524 1.524)
)
(justify left top)
)
(uuid "5b336716-ca6f-51c1-93b1-9f9f76e789f6")
)
(text "To the fascia: JST PH, 6 ways, top entry."
(exclude_from_sim no)
(at 116.84 53.34 0)
(effects
(font
(size 1.27 1.27)
)
(justify left top)
)
(uuid "34aeef7e-505e-5512-b1fe-f2d510671298")
)
(text "Parts this sheet's layout does not know yet (added to tools/ts06pair.py since): labelled, not wired."
(exclude_from_sim no)
(at 20.32 69.85 0)
(effects
(font
(size 1.27 1.27)
(bold yes)
)
(justify left top)
)
(uuid "e7eb3789-f676-555b-91b8-8525d3e8788c")
)
(text "Notes from tools/ts06pair.py"
(exclude_from_sim no)
(at 20.32 113.03 0)
(effects
(font
(size 1.524 1.524)
(bold yes)
)
(justify left top)
)
(uuid "81fca8d7-b539-583e-971d-a5311395de31")
)
(text "C5: Ladder filters at the board end (spec §2).\nC18: At J1, on the cable side of R73.\nJ1: The panel cable; pin order is the specification both fascia builds share. Top entry, so the cable leaves\ntowards the fascia.\nR72: A6 pull-down: a defined 0 with the fascia unplugged.\nR73: Series resistor on the button line, at J1."
(exclude_from_sim no)
(at 20.32 115.57 0)
(effects
(font
(size 1.27 1.27)
)
(justify left top)
)
(uuid "c4246ae7-eea2-54eb-a972-c150d8e16737")
)
