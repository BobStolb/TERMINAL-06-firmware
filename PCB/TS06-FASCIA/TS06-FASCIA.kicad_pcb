(footprint "TS06_CablePads_6"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "B.Cu")
	(uuid "6b67407d-da89-4624-9d52-f41226548fec")
	(at 158.0000 45.0000)
	(descr "Six back-side solder lands for the panel cable: 1 GND, 2 +5V, 3 A6, 4 A7, 5 D7, 6 D8. Pad 1 marked by a silk arrow. Direct-solder rather than a connector, because JST-XH is through-hole and this board puts no hole through its front face. Strain relief is provided by the chassis, not the board.")
	(tags "cable pads panel solder TERMINAL-06")
	(attr through_hole)
	(property "Reference" "J1"
		(at 0 -3.4 0)
		(layer "B.SilkS")
		(uuid "138d092d-56ed-4f57-9ef9-aa4f2e5808e3")
		(effects
