@@ -0,0 +1,97 @@
+#!/usr/bin/env python3
+"""The Fronts view's pictures and data: web copies of the art the owner shortlisted, made at build time.
+
+    python3 fronts.py REPO SITE [LIST]
+
+Reads (the repository is only read):
+  LIST (default: fronts.json beside this script)   the faces, their status, captions and light notes
+  REPO/PCB/art/...png                               each face's picture, as drawn by its run
+  REPO/PCB/art/...md                                each face's write-up: it must exist and name the picture
+Writes:
+  SITE/img/fronts/<id>.webp        the picture, the longest side 2400 px or less, a few hundred kB (the quality steps down to fit)
+  SITE/img/fronts/<id>-card.webp   a 1200 px copy for the page's cards (the full one opens on a click)
+  SITE/data/fronts.json            what the page prints
+Nothing is written under PCB/art: the web copies live in the built site only.
+"""
+import json, os, sys
+
+from PIL import Image
+
+FULL, CARD = 2400, 1200          # longest side, px
+BUDGET, CARD_BUDGET = 480 * 1024, 160 * 1024
+STATUS = {"final candidate", "approved"}
+
+
+def webp(im, path, longest, budget):
+    w, h = im.size
+    k = min(1.0, longest / max(w, h))
+    if k < 1.0:
+        im = im.resize((round(w * k), round(h * k)), Image.LANCZOS)
+    for q in (80, 76, 72, 68, 64, 60):
+        im.save(path, "WEBP", quality=q, method=5)
+        if os.path.getsize(path) <= budget:
+            break
+    return {"w": im.size[0], "h": im.size[1], "bytes": os.path.getsize(path), "q": q}
+
+
+def picture(repo, site, pid, src):
+    p = os.path.join(repo, src)
+    if not os.path.isfile(p):
+        sys.exit("fronts.py: %s is listed but is not in the repository" % src)
+    im = Image.open(p).convert("RGB")
+    full = webp(im, os.path.join(site, "img", "fronts", pid + ".webp"), FULL, BUDGET)
+    card = webp(im, os.path.join(site, "img", "fronts", pid + "-card.webp"), CARD, CARD_BUDGET)
+    return {"src": "img/fronts/%s.webp" % pid, "card": "img/fronts/%s-card.webp" % pid, "w": full["w"], "h": full["h"],
+            "bytes": full["bytes"], "card_bytes": card["bytes"], "card_w": card["w"], "card_h": card["h"], "from": src, "from_size": list(im.size)}
+
+
+def checked(repo, e):
+    for k in ("id", "name", "status", "src", "writeup", "caption"):
+        if not e.get(k):
+            sys.exit("fronts.py: %s has no %r" % (e.get("id", "?"), k))
+    if e["status"] not in STATUS:
+        sys.exit("fronts.py: %s: status %r is not one of %s" % (e["id"], e["status"], sorted(STATUS)))
+    md = os.path.join(repo, e["writeup"])
+    if not os.path.isfile(md):
+        sys.exit("fronts.py: %s: its write-up %s is not in the repository" % (e["id"], e["writeup"]))
+    text = open(md, encoding="utf8").read()
+    if os.path.basename(e["src"]) not in text:
+        sys.exit("fronts.py: %s: %s does not name %s" % (e["id"], e["writeup"], os.path.basename(e["src"])))
+    if e.get("section") and e["section"] not in text:
+        sys.exit("fronts.py: %s: %s has no section %r" % (e["id"], e["writeup"], e["section"]))
+    return e
+
+
+def main(repo, site, lst=None):
+    L = json.load(open(lst or os.path.join(os.path.dirname(os.path.abspath(__file__)), "fronts.json"), encoding="utf8"))
+    os.makedirs(os.path.join(site, "img", "fronts"), exist_ok=True)
+    d = checked(repo, dict(L["display"]))
+    d.update(picture(repo, site, d["id"], d["src"]))
+    if d.get("colours"):
+        c = dict(d["colours"])
+        c.update(picture(repo, site, c["id"], c["src"]))
+        d["colours"] = c
+    fas = []
+    for e in L["fascias"]:
+        e = checked(repo, dict(e))
+        if not e.get("lights"):
+            sys.exit("fronts.py: %s has no light note" % e["id"])
+        e.update(picture(repo, site, e["id"], e["src"]))
+        fas.append(e)
+    if len({e["id"] for e in fas}) != len(fas):
+        sys.exit("fronts.py: two fascias share an id")
+    for k in ("grill",):
+        if L.get(k) and not os.path.isfile(os.path.join(repo, L[k])):
+            sys.exit("fronts.py: %s is not in the repository" % L[k])
+    out = {"round": L["round"], "display": d, "fascias": fas, "in_review": L.get("in_review", []), "drawings": L["drawings"],
+           "grill": L.get("grill"), "source": "recovered/viewer2/tools/fronts.json; the pictures from PCB/art, web copies made by tools/fronts.py"}
+    json.dump(out, open(os.path.join(site, "data", "fronts.json"), "w", encoding="utf8"), ensure_ascii=False, indent=1)
+    pics = [d] + ([d["colours"]] if d.get("colours") else []) + fas
+    tot = sum(p["bytes"] + p["card_bytes"] for p in pics)
+    print("fronts: display %s, %d fascias (%s), %d pictures, %d files, %.1f MB; largest %d kB" % (
+        d["id"], len(fas), ", ".join("%s %s" % (e["id"], e["status"]) for e in fas), len(pics), 2 * len(pics), tot / 1048576,
+        max(p["bytes"] for p in pics) // 1024))
+
+
+if __name__ == "__main__":
+    main(sys.argv[1], sys.argv[2], *(sys.argv[3:4]))
